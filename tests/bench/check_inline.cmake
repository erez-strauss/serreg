# tests/bench/check_inline.cmake — 2.1.12 (cc review 2.1.10, C-08): compiles hot_inline.cpp at -O2 to assembly and
# fails when the function hot() contains a call. Run as: cmake -DCXX=… -DFLAGS=… -DSRC=… -DOUT=… -P check_inline.cmake
separate_arguments(flag_list UNIX_COMMAND "${FLAGS}")
execute_process(COMMAND ${CXX} ${flag_list} -O2 -S -o ${OUT} ${SRC} RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "compiling ${SRC} failed:\n${err}")
endif()
file(STRINGS ${OUT} lines)
set(in_hot FALSE)
set(calls 0)
set(body 0)
foreach(l IN LISTS lines)
  if(l MATCHES "^hot:")
    set(in_hot TRUE)
  elseif(in_hot AND l MATCHES "\\.cfi_endproc|^\\.Lfe[0-9]+:|\\.size[ \t]+hot,")
    break()
  elseif(in_hot)
    math(EXPR body "${body} + 1")
    if(l MATCHES "^[ \t]+(call|jmp[ \t]+[A-Za-z_])")
      if(NOT l MATCHES "jmp[ \t]+\\.L")
        math(EXPR calls "${calls} + 1")
        message(STATUS "call in hot(): ${l}")
      endif()
    endif()
  endif()
endforeach()
if(body EQUAL 0)
  message(FATAL_ERROR "no body for hot() found in ${OUT}")
endif()
if(calls GREATER 0)
  message(FATAL_ERROR "hot() makes ${calls} call(s) at -O2: serialize() is not fully inlined")
endif()
message(STATUS "hot(): ${body} lines, no call at -O2")
