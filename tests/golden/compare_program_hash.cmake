# `srdump --program-hash` must print the same value for the capture and its RRI (and, when ELF is given, for the
# generator binary's ELF dictionary).
execute_process(COMMAND ${SRDUMP} ${CAPTURE} --program-hash OUTPUT_VARIABLE a RESULT_VARIABLE ra OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(COMMAND ${SRDUMP} --rri ${RRI} --program-hash OUTPUT_VARIABLE b RESULT_VARIABLE rb OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT ra EQUAL 0 OR NOT rb EQUAL 0)
  message(FATAL_ERROR "srdump --program-hash failed: ${ra} ${rb}")
endif()
if(NOT a MATCHES "^0x[0-9a-f]+$" OR a MATCHES "^0x0+$")
  message(FATAL_ERROR "unexpected --program-hash output '${a}'")
endif()
if(NOT a STREQUAL b)
  message(FATAL_ERROR "program hashes differ: capture=${a} rri=${b}")
endif()
if(ELF)
  execute_process(COMMAND ${SRDUMP} --elf ${ELF} --program-hash OUTPUT_VARIABLE c RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT rc EQUAL 0 OR NOT a STREQUAL c)
    message(FATAL_ERROR "program hash from ELF differs: capture=${a} elf=${c} (rc ${rc})")
  endif()
endif()
message(STATUS "program hash ${a} agrees")
