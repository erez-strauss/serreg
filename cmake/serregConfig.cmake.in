@PACKAGE_INIT@
# The serreg package (2.1.13, decision G): three libraries, one package.
#   find_package(serreg CONFIG REQUIRED)                      every component this installation has
#   find_package(serreg CONFIG REQUIRED COMPONENTS ipc)       es::ipc only (header-only, C++23, no reflection)
#   find_package(serreg CONFIG REQUIRED COMPONENTS serreg)    es::serreg (the runtime: registry, readers, decoder)
#   find_package(serreg CONFIG REQUIRED COMPONENTS tools)     es::serreg_tools (srdump's CLI, Wireshark, diff)
# es::serreg does not bring es::ipc: link both when both are used. An ES_SERREG_IPC_ONLY installation has ipc only.
include(CMakeFindDependencyMacro)
set(_serreg_available ipc)
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/serregTargets.cmake")
  list(APPEND _serreg_available serreg tools)
endif()
set(_serreg_wanted ${serreg_FIND_COMPONENTS})
if(NOT _serreg_wanted)
  set(_serreg_wanted ${_serreg_available})
endif()
foreach(_c IN LISTS _serreg_wanted)
  if(_c IN_LIST _serreg_available)
    set(serreg_${_c}_FOUND TRUE)
  else()
    set(serreg_${_c}_FOUND FALSE)
  endif()
endforeach()
if("ipc" IN_LIST _serreg_wanted)
  include("${CMAKE_CURRENT_LIST_DIR}/serregIpcTargets.cmake")
endif()
if(serreg_serreg_FOUND OR serreg_tools_FOUND)
  find_dependency(Threads)
  include("${CMAKE_CURRENT_LIST_DIR}/serregTargets.cmake")
endif()
unset(_serreg_available)
unset(_serreg_wanted)
check_required_components(serreg)
